#!name = PingMe签到
#!desc = PingMe 每日自动签到 + 视频奖励。fmz200 原版脚本直引（与 Surge / Egern 一致）。抓参开关打开后进 PingMe App 触发一次余额查询即自动保存签到参数；定时任务默认每天 0 点起每 4 小时运行一次；API 出口策略可在插件参数里切换（默认直连）。
#!author = fmz200（原版脚本）
#!homepage = https://github.com/mickeu/Egern
#!icon = https://raw.githubusercontent.com/axhani/icon/refs/heads/main/pingme&wetalk.png
#!tag = 签到,工具
#!type = normal

# ============ 说明 ============
# .lpx 是纯文本单文件，无法内嵌脚本；直接引用 fmz200 原版脚本（与 Surge / Egern 一致）。
# script-path 指向：
#   https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/PingMe/PingMeSignin.js
#   https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cookie/get_cookie.js

[Argument]
cronExp = input,"0 */4 * * *",tag=签到定时,desc=cron 表达式（分 时 日 月 周），默认每天 0 点起每 4 小时运行一次
capture = switch,true,tag=抓参开关,desc=打开后进 PingMe App 触发一次余额查询即自动抓取签到参数，抓到后建议关闭
proxyPolicy = input,"DIRECT",tag=API出口策略,desc=api.pingmeapp.net 走哪个策略组，默认 DIRECT（直连最稳）；想试 0.004 视频奖励可填美国节点策略组名，需与配置中的名称完全一致

[General]
script-update-interval = 3600

[Rule]
# API 出口策略可在插件参数里配置（proxyPolicy），默认 DIRECT；
# 2026-10-02 实测 Loon 经代理到 api.pingmeapp.net 会 hang 住超时，直连正常
DOMAIN,api.pingmeapp.net,{proxyPolicy}

[Script]
cron {cronExp} script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/PingMe/PingMeSignin.js,timeout=300,tag=PingMe签到
http-request ^https:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus script-path=https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cookie/get_cookie.js,tag=PingMe抓参,timeout=60,requires-body=false,enable={capture}

[Mitm]
hostname = api.pingmeapp.net
