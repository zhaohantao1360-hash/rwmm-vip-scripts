#!name = PingMe签到
#!desc = PingMe 每日自动签到 + 视频奖励。抓参开关打开后进 PingMe App 触发一次余额查询即自动保存签到参数；定时任务默认每天 0 点起每 4 小时运行一次。由 mickeu 的 Egern 版移植为 Loon 插件。
#!author = mickeu（Egern 原版）
#!homepage = https://github.com/mickeu/Egern
#!icon = https://raw.githubusercontent.com/axhani/icon/refs/heads/main/pingme&wetalk.png
#!tag = 签到,工具
#!type = normal

# ============ 说明 ============
# .lpx 是纯文本单文件，无法内嵌脚本；两个 JS 已托管在下方 raw 地址，Loon 可直接拉取。
# script-path 指向：
#   https://raw.githubusercontent.com/zhaohantao1360-hash/rwmm-vip-scripts/main/PingMeSignin_loon.js
#   https://raw.githubusercontent.com/zhaohantao1360-hash/rwmm-vip-scripts/main/pingme_capture_loon.js

[Argument]
cronExp = input,"0 */4 * * *",tag=签到定时,desc=cron 表达式（分 时 日 月 周），默认每天 0 点起每 4 小时运行一次
capture = switch,true,tag=抓参开关,desc=打开后进 PingMe App 触发一次余额查询即自动抓取签到参数，抓到后建议关闭

[General]
script-update-interval = 3600

[Rule]
# 2026-10-02 实测：经代理到 api.pingmeapp.net 会 hang 住 15s 超时，改直连后 5 个视频全成功
DOMAIN,api.pingmeapp.net,DIRECT

[Script]
cron {cronExp} script-path=https://raw.githubusercontent.com/zhaohantao1360-hash/rwmm-vip-scripts/main/PingMeSignin_loon.js,timeout=300,tag=PingMe签到
http-request ^https:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus script-path=https://raw.githubusercontent.com/zhaohantao1360-hash/rwmm-vip-scripts/main/pingme_capture_loon.js,tag=PingMe抓参,timeout=60,requires-body=false,enable={capture}

[Mitm]
hostname = api.pingmeapp.net
